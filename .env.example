# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aikos?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-random-32-char-minimal"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage (pilih salah satu) - untuk upload foto/video kos, KTP, bukti bayar
UPLOADTHING_TOKEN=""
# atau S3-compatible:
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="ap-southeast-1"

# Maps
NEXT_PUBLIC_MAPS_API_KEY=""

# Payment Gateway (adapter Midtrans/Xendit - isi salah satu, app pakai interface gateway.ts)
PAYMENT_PROVIDER="mock" # mock | midtrans | xendit
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
XENDIT_API_KEY=""

# AI / LLM
AI_PROVIDER="mock" # mock | openai | gemini | anthropic
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-4o-mini"

# App
NEXT_PUBLIC_APP_NAME="AI-KOS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
